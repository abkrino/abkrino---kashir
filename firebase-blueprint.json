{
  "entities": {
    "Store": {
      "title": "Store",
      "description": "Supermarket and dairy retail branch profile and configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "ownerEmail": { "type": "string", "maxLength": 120 },
        "autoCloudSync": { "type": "boolean" },
        "offlineModeEnabled": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "ownerEmail"]
    },
    "Product": {
      "title": "Product",
      "description": "Retail supermarket and dairy inventory item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string", "maxLength": 50 },
        "name": { "type": "string", "maxLength": 150 },
        "brand": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 80 },
        "stockPieces": { "type": "number" },
        "costPricePerBase": { "type": "number" },
        "retailPricePerBase": { "type": "number" },
        "isWeighing": { "type": "boolean" },
        "storageType": { "type": "string", "enum": ["AMBIENT", "CHILLED", "FROZEN"] },
        "barcode": { "type": "string", "maxLength": 60 },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "code", "name", "stockPieces", "retailPricePerBase"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Retail customer, delivery client, or credit account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 30 },
        "area": { "type": "string", "maxLength": 100 },
        "priceTier": { "type": "string", "enum": ["RETAIL", "HALF_WHOLESALE", "WHOLESALE"] },
        "currentBalance": { "type": "number" },
        "creditLimit": { "type": "number" },
        "isCreditAllowed": { "type": "boolean" }
      },
      "required": ["id", "name", "currentBalance"]
    },
    "SalesInvoice": {
      "title": "SalesInvoice",
      "description": "Retail cashier sale receipt and itemized transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string", "maxLength": 50 },
        "date": { "type": "string", "maxLength": 20 },
        "time": { "type": "string", "maxLength": 20 },
        "customerId": { "type": "string", "maxLength": 100 },
        "customerName": { "type": "string", "maxLength": 120 },
        "total": { "type": "number" },
        "paidAmount": { "type": "number" },
        "remainingAmount": { "type": "number" },
        "paymentType": { "type": "string", "enum": ["CASH", "CARD", "WALLET", "CREDIT", "SPLIT"] },
        "cashierName": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "invoiceNumber", "total", "paidAmount", "paymentType"]
    },
    "CloudBackup": {
      "title": "CloudBackup",
      "description": "Full snapshot backup saved to Cloud with restore capabilities",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "dateStr": { "type": "string", "maxLength": 30 },
        "itemCounts": { "type": "string", "maxLength": 200 },
        "totalValuation": { "type": "number" },
        "payloadJson": { "type": "string" },
        "createdBy": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "timestamp", "payloadJson"]
    },
    "CrashReport": {
      "title": "CrashReport",
      "description": "Crashlytics error and exception log for Cloud monitoring",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "message": { "type": "string", "maxLength": 500 },
        "component": { "type": "string", "maxLength": 100 },
        "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "resolved": { "type": "boolean" }
      },
      "required": ["id", "timestamp", "message", "severity"]
    },
    "PerformanceMetric": {
      "title": "PerformanceMetric",
      "description": "Cloud performance and latency benchmark metric",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "operation": { "type": "string", "maxLength": 100 },
        "durationMs": { "type": "number" },
        "status": { "type": "string", "maxLength": 30 },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "operation", "durationMs"]
    },
    "CloudAlert": {
      "title": "CloudAlert",
      "description": "Cloud Messaging notification message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "body": { "type": "string", "maxLength": 500 },
        "type": { "type": "string", "enum": ["STOCK", "EXPIRY", "FINANCE", "SYSTEM"] },
        "timestamp": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["id", "title", "body", "type"]
    }
  },
  "firestore": {
    "/stores/{storeId}": {
      "schema": "Store",
      "description": "Branch store configuration"
    },
    "/stores/{storeId}/products/{productId}": {
      "schema": "Product",
      "description": "Store inventory products catalog"
    },
    "/stores/{storeId}/customers/{customerId}": {
      "schema": "Customer",
      "description": "Customer accounts and credit ledgers"
    },
    "/stores/{storeId}/invoices/{invoiceId}": {
      "schema": "SalesInvoice",
      "description": "Store sales invoices and bills"
    },
    "/stores/{storeId}/cloudBackups/{backupId}": {
      "schema": "CloudBackup",
      "description": "Cloud backup snapshots"
    },
    "/stores/{storeId}/crashReports/{reportId}": {
      "schema": "CrashReport",
      "description": "Crashlytics error reports"
    },
    "/stores/{storeId}/performanceMetrics/{metricId}": {
      "schema": "PerformanceMetric",
      "description": "Cloud performance latency logs"
    },
    "/stores/{storeId}/cloudAlerts/{alertId}": {
      "schema": "CloudAlert",
      "description": "Cloud Messaging broadcast notices"
    }
  }
}
