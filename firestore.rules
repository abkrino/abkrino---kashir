rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isStoreOwner(storeId) {
      return isSignedIn() && (
        request.auth.token.email == 'mahmoud.mansour0b@gmail.com' ||
        request.auth.uid == storeId ||
        request.auth.uid != null
      );
    }

    // Stores collection
    match /stores/{storeId} {
      allow read, write: if isSignedIn() && isValidId(storeId);

      // Products subcollection
      match /products/{productId} {
        allow read, write: if isSignedIn() && isValidId(storeId) && isValidId(productId);
      }

      // Customers subcollection
      match /customers/{customerId} {
        allow read, write: if isSignedIn() && isValidId(storeId) && isValidId(customerId);
      }

      // Invoices subcollection
      match /invoices/{invoiceId} {
        allow read, write: if isSignedIn() && isValidId(storeId) && isValidId(invoiceId);
      }

      // Cloud Backups subcollection
      match /cloudBackups/{backupId} {
        allow read, write: if isSignedIn() && isValidId(storeId) && isValidId(backupId);
      }

      // Crashlytics reports subcollection
      match /crashReports/{reportId} {
        allow read, write: if isSignedIn() && isValidId(storeId) && isValidId(reportId);
      }

      // Performance metrics subcollection
      match /performanceMetrics/{metricId} {
        allow read, write: if isSignedIn() && isValidId(storeId) && isValidId(metricId);
      }

      // Cloud Alerts / Messaging subcollection
      match /cloudAlerts/{alertId} {
        allow read, write: if isSignedIn() && isValidId(storeId) && isValidId(alertId);
      }
    }
  }
}
