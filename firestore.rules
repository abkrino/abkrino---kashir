// لا تُنشر قبل ربط التطبيق بالمخطط الجديد (الخطوة اللاحقة)
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Global Safety Net: Default Deny All
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if the authenticated user has a document in the admins collection
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Check if the authenticated user is the owner of this organization
    function isOrgOwner(orgId) {
      return isSignedIn() && request.auth.uid == orgId;
    }

    // Default grace period is 7 days if graceDays is omitted from orgs/{orgId}
    function getOrgGraceDays(org) {
      return ('graceDays' in org && org.graceDays is int && org.graceDays >= 0) ? org.graceDays : 7;
    }

    // Check if the organization has an active status and valid subscription (including graceDays)
    function isOrgActive(orgId) {
      let org = get(/databases/$(database)/documents/orgs/$(orgId)).data;
      return org.status == 'active' &&
        (org.validUntil + duration.value(getOrgGraceDays(org), 'd')) > request.time;
    }

    // Check if the organization is within the 30-day post-expiry cloud restore window
    function isWithinRestoreWindow(orgId) {
      let org = get(/databases/$(database)/documents/orgs/$(orgId)).data;
      return (org.status in ['active', 'suspended']) &&
        (org.validUntil + duration.value(30, 'd')) > request.time;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidDateId(id) {
      return id is string && id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // -------------------------------------------------------------------------
    // 1. Admins Collection
    // Created manually in Console. No write access from any client.
    // -------------------------------------------------------------------------
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // 2. Organizations Private Collection (orgsPrivate/{orgId})
    // Internal administrative metadata (notes, private tags, internal billing).
    // Accessible EXCLUSIVELY by Superadmin (Read & Write). Client has ZERO access.
    // -------------------------------------------------------------------------
    match /orgsPrivate/{orgId} {
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 3. Organizations Collection (orgs/{orgId} where orgId == uid)
    // Read: Owner or Admin.
    // Write: Admin ONLY. Client cannot create or edit org fields.
    // -------------------------------------------------------------------------
    match /orgs/{orgId} {
      allow read: if isOrgOwner(orgId) || isAdmin();
      allow write: if isAdmin();

      // -----------------------------------------------------------------------
      // Branches Subcollection
      // Create/Delete: Admin only.
      // Update: Admin OR Owner updating heartbeat/version fields with active sub.
      // Heartbeat lastSeenAt MUST equal request.time (serverTimestamp).
      // -----------------------------------------------------------------------
      match /branches/{branchId} {
        allow read: if isOrgOwner(orgId) || isAdmin();
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || (
          isOrgOwner(orgId) &&
          isOrgActive(orgId) &&
          isValidId(branchId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastSeenAt',
            'appVersion',
            'windowsVersion',
            'mode'
          ]) &&
          request.resource.data.lastSeenAt == request.time
        );

        // ---------------------------------------------------------------------
        // Daily Summaries Subcollection (yyyy-MM-dd)
        // Read: Owner or Admin.
        // Write: Owner only with active subscription and valid schema.
        // ---------------------------------------------------------------------
        match /dailySummaries/{dateId} {
          allow read: if isOrgOwner(orgId) || isAdmin();
          allow create, update: if isOrgOwner(orgId) &&
            isOrgActive(orgId) &&
            isValidDateId(dateId) &&
            request.resource.data.salesTotal is number &&
            request.resource.data.invoiceCount is int &&
            request.resource.data.cashInDrawer is number &&
            request.resource.data.purchasesTotal is number &&
            request.resource.data.customerDebt is number &&
            request.resource.data.supplierDue is number &&
            request.resource.data.lowStockCount is int &&
            request.resource.data.updatedAt is timestamp;
          allow delete: if false;
        }

        // ---------------------------------------------------------------------
        // Backups Subcollection (Metadata Doc + chunks Subcollection)
        // Metadata & Chunks Read: Owner ONLY within 30-day restore window.
        // Metadata Write/Delete: Owner with active subscription (incl. graceDays).
        // Chunks Write/Delete: Owner with active subscription (<= 900,000 bytes).
        // ---------------------------------------------------------------------
        match /backups/{backupId} {
          allow read: if isOrgOwner(orgId) && isWithinRestoreWindow(orgId);
          allow create, update: if isOrgOwner(orgId) &&
            isOrgActive(orgId) &&
            isValidId(backupId) &&
            request.resource.data.metadata is map &&
            request.resource.data.metadata.sizeBytes is number &&
            request.resource.data.metadata.createdAt is timestamp &&
            request.resource.data.metadata.appVersion is string;
          allow delete: if isOrgOwner(orgId) && isOrgActive(orgId);

          match /chunks/{chunkIndex} {
            allow read: if isOrgOwner(orgId) && isWithinRestoreWindow(orgId);
            allow create, update: if isOrgOwner(orgId) &&
              isOrgActive(orgId) &&
              request.resource.data.data is string &&
              request.resource.data.data.size() <= 900000;
            allow delete: if isOrgOwner(orgId) && isOrgActive(orgId);
          }
        }
      }

      // -----------------------------------------------------------------------
      // License Events Subcollection
      // Read: Owner or Admin.
      // Write: FORBIDDEN from all clients (Server-side Admin SDK only).
      // -----------------------------------------------------------------------
      match /licenseEvents/{eventId} {
        allow read: if isOrgOwner(orgId) || isAdmin();
        allow write: if false;
      }
    }

    // -------------------------------------------------------------------------
    // Collection Group Queries (Superadmin Dashboard Queries across all orgs)
    // -------------------------------------------------------------------------
    match /{path=**}/branches/{branchId} {
      allow read: if isAdmin();
    }

    match /{path=**}/dailySummaries/{dateId} {
      allow read: if isAdmin();
    }

    match /{path=**}/backups/{backupId} {
      allow read: if isAdmin();
    }

    match /{path=**}/licenseEvents/{eventId} {
      allow read: if isAdmin();
    }
  }
}
